<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_model</name>
  <version>0.0.0</version>
  <description>
    This package contains the URDFs for the apple picking robot.
    These URDFs are not particularly accurate and should not be used as CAD reference
  </description>
  <maintainer email="devanneil2004@gmail.com">Devan Neil</maintainer>
  <license>MIT</license>
  <url type="website">https://github.com/devanneil/AutomaticAppleHarvesterCOBOT</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>duco_support</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
