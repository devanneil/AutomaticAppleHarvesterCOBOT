<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>apple_interfaces</name>
  <version>0.0.0</version>
  <description>
    This package describes the interfaces between nodes for the Apple Picking system.
  </description>
  <maintainer email="devanneil2004@gmail.com">Devan Neil</maintainer>
  <license>MIT</license>
  <url type="website">https://github.com/devanneil/AutomaticAppleHarvesterCOBOT</url>

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
